# Copy this file to .env and fill in the values you have.
# The API starts without LLM keys and falls back to a local heuristic parser.

# --- LLM parsing (optional; heuristic parser is used if empty) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LLM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Database (SQLite by default; swap to Postgres / Supabase by changing this URL) ---
DATABASE_URL=sqlite:///./scans.db

# --- CORS (comma-separated origins). Use * for local hackathon testing. ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# --- OCR ---
OCR_LANG=en
MAX_IMAGES=3
MAX_UPLOAD_BYTES=12582912
